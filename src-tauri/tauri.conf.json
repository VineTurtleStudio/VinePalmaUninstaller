{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VinePalmaUninstaller",
  "version": "1.0.0",
  "identifier": "com.vinepalma.uninstaller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VinePalma 卸载器",
        "width": 980,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "backgroundColor": "#1a1d23"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/usr/share/**",
          "/usr/local/share/**",
          "/var/lib/flatpak/**",
          "/var/lib/snapd/**",
          "/var/lib/apm/**",
          "/snap/**",
          "/opt/**",
          "~/.local/share/**",
          "~/.local/state/**",
          "~/.config/**",
          "~/.cache/**",
          "~/.icons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "desktopTemplate": "desktop.desktop"
      }
    }
  }
}
